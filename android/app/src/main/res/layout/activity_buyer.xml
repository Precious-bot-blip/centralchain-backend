<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <include layout="@layout/view_header" />

    <!-- main action for the buyer -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_new_order"
        style="@style/CC.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="Order Supplies" />

    <TextView
        style="@style/CC.Pill.Primary"
        android:text="Past Orders" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_past_orders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        style="@style/CC.Pill.Primary"
        android:text="Active orders" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_active_orders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            style="@style/CC.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log out" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_chat"
            style="@style/CC.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chat" />
    </LinearLayout>
</LinearLayout>
